@media (max-width: 1023.98px) {
  .slide-item-header[data-v-98fd9269] { min-height: 80px; }
}

.trading-accounts-card[data-v-3867b86e] { min-width: 248px; background-color: rgb(var(--v-theme-white)); cursor: default; border: 1px solid rgb(var(--v-theme-gray-20)) !important; border-radius: 24px !important; }

@media (max-width: 1023.98px) {
  .trading-accounts-card[data-v-3867b86e] { border-radius: 16px !important; }
}

.trading-accounts-card__divider[data-v-3867b86e] { width: 5px; height: 5px; background-color: rgb(var(--v-theme-gray-100)); border-radius: 1px; transform: rotate(-44deg); }

.v-locale--is-rtl .trading-accounts-card__divider[data-v-3867b86e] { margin-top: -2px; }

.trading-accounts-card__bonus-tooltip[data-v-3867b86e] { cursor: pointer; }

.trading-accounts-card__number[data-v-3867b86e] { white-space: nowrap; }

.trading-accounts-card__ecn-discount[data-v-3867b86e] { background-color: rgb(245, 234, 228); border: 1px solid rgb(246, 224, 212); border-radius: 4px; font-size: 12px !important; color: rgb(207, 93, 31) !important; }

.trading-accounts-card--level-0[data-v-3867b86e], .trading-accounts-card__active[data-v-3867b86e] { border-color: rgb(var(--v-theme-gray-60)) !important; }

.trading-accounts-card--gold.trading-accounts-card--level-0[data-v-3867b86e], .trading-accounts-card--gold.trading-accounts-card__active[data-v-3867b86e] { border-color: var(--primary-gold-90) !important; }

.trading-accounts-card__wrapper[data-v-ac47eeb6] .app-slider { padding-bottom: 0px !important; }

@media (max-width: 1023.98px) {
  .trading-accounts-card__wrapper[data-v-ac47eeb6] .app-slider__slide { flex-shrink: 1 !important; margin-right: 8px; }
}

@media (max-width: 1423.98px) {
  .trading-accounts-card__wrapper[data-v-ac47eeb6] .app-slider__slide { width: 100%; }
}

.trading-accounts-card__wrapper[data-v-ac47eeb6] .app-slider__slider { margin: 0px 8px; }

.trading-accounts-card__wrapper .slider-with-one-slide[data-v-ac47eeb6] .app-slider__slider { margin-right: auto; margin-left: 8px; }
