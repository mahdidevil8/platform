.v-picker.v-sheet.v-picker--with-actions { grid-template-areas: "title" "header" "body" "actions"; }

.v-picker__body { grid-area: body; }

.v-picker__header { grid-area: header; }

.v-picker__actions { grid-area: actions; padding: 0px 12px 12px; display: flex; align-items: center; justify-content: flex-end; }

.v-picker__actions .v-btn { min-width: 48px; }

.v-picker__actions .v-btn:not(:last-child) { margin-inline-end: 8px; }

.v-picker--landscape { }

.v-picker--landscape.v-picker--with-actions { }

.v-picker-title { text-transform: uppercase; font-size: 0.75rem; grid-area: title; padding-inline: 24px 12px; padding-top: 16px; padding-bottom: 16px; font-weight: 400; letter-spacing: 0.166667em; }

