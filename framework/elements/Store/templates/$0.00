.v-expansion-panels--variant-accordion .v-expansion-panel-title__overlay { transition: border-radius 0.3s cubic-bezier(0.4, 0, 0.2, 1); }

.v-expansion-panel { flex: 1 0 100%; max-width: 100%; position: relative; transition: margin-top 0.3s cubic-bezier(0.4, 0, 0.2, 1), border-radius, border, max-width; border-radius: 8px; }

