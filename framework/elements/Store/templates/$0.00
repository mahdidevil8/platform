.driver-popover-footer .driver-popover-btn-disabled { opacity: 0.5; pointer-events: none; }

:not(body):has(> .driver-active-element) { overflow: hidden !important; }

.driver-no-interaction, .driver-no-interaction * { pointer-events: none !important; }

.driver-popover-footer button:hover, .driver-popover-footer button:focus { background-color: rgb(247, 247, 247); }

.driver-popover-navigation-btns { display: flex; flex-grow: 1; justify-content: flex-end; }

.driver-popover-navigation-btns button + button { margin-left: 4px; }

.driver-popover-arrow { content: ""; position: absolute; border: 5px solid rgb(255, 255, 255); }

.driver-popover-arrow-side-over { display: none; }

.driver-popover-arrow-side-left { left: 100%; border-right-color: transparent; border-bottom-color: transparent; border-top-color: transparent; }

.driver-popover-arrow-side-right { right: 100%; border-left-color: transparent; border-bottom-color: transparent; border-top-color: transparent; }

.driver-popover-arrow-side-top { top: 100%; border-right-color: transparent; border-bottom-color: transparent; border-left-color: transparent; }

.driver-popover-arrow-side-bottom { bottom: 100%; border-left-color: transparent; border-top-color: transparent; border-right-color: transparent; }

.driver-popover-arrow-side-center { display: none; }

.driver-popover-arrow-side-left.driver-popover-arrow-align-start, .driver-popover-arrow-side-right.driver-popover-arrow-align-start { top: 15px; }

.driver-popover-arrow-side-top.driver-popover-arrow-align-start, .driver-popover-arrow-side-bottom.driver-popover-arrow-align-start { left: 15px; }

.driver-popover-arrow-align-end.driver-popover-arrow-side-left, .driver-popover-arrow-align-end.driver-popover-arrow-side-right { bottom: 15px; }

.driver-popover-arrow-side-top.driver-popover-arrow-align-end, .driver-popover-arrow-side-bottom.driver-popover-arrow-align-end { right: 15px; }

.driver-popover-arrow-side-left.driver-popover-arrow-align-center, .driver-popover-arrow-side-right.driver-popover-arrow-align-center { top: 50%; margin-top: -5px; }

.driver-popover-arrow-side-top.driver-popover-arrow-align-center, .driver-popover-arrow-side-bottom.driver-popover-arrow-align-center { left: 50%; margin-left: -5px; }

.driver-popover-arrow-none { display: none; }

.driver-popover.onboarding { padding: 16px; border-radius: 16px; background: var(--background-primary-elevated, #fff); }

.driver-popover * { font-family: inherit; font-style: normal; font-weight: 500; }

.driver-popover.onboarding .driver-popover-title { color: var(--text-secondary, #777F86); font-size: var(--font-size-s, 14px); line-height: 20px; }

@media screen and (max-width: 1024px) {
  .driver-popover.onboarding .driver-popover-title { font-size: var(--font-size-xs, 12px); line-height: 16px; }
}

.driver-popover.onboarding .driver-popover-description { margin-top: 8px; color: var(--text-headline, #040404); font-size: var(--font-size-m, 16px); line-height: 24px; }

@media screen and (max-width: 1024px) {
  .driver-popover.onboarding .driver-popover-description { font-size: var(--font-size-s, 14px); line-height: 20px; }
}

.driver-popover.onboarding .driver-popover-footer { margin-top: 12px; }

.driver-popover.onboarding button { height: 32px; padding: 0px 12px; justify-content: center; align-items: center; gap: 4px; border-radius: 4px; color: var(--absolute-white, #ffffff); font-family: inherit; font-size: var(--font-size-s, 14px); font-style: normal; font-weight: 600; line-height: 1; text-shadow: none; border: none; display: flex !important; }

@media screen and (max-width: 1024px) {
  .driver-popover.onboarding button { height: 24px; padding: 0px 8px; }
}

.driver-popover.onboarding .driver-popover-next-btn { border: 1px solid var(--transparent-gray-10, rgba(37, 42, 46, .1)); background: var(--controls-primary-active, #fa6a1c); }

.driver-popover.onboarding .driver-popover-next-btn:hover { background: linear-gradient(0deg,var(--transparent-gray-10, rgba(37, 42, 46, .1)) 0%,var(--transparent-gray-10, rgba(37, 42, 46, .1)) 100%),var(--controls-primary-active, #fa6a1c); }

.driver-popover.onboarding .driver-popover-skip-btn, .driver-popover.onboarding .driver-popover-prev-btn { margin-inline-end: auto; color: var(--text-primary, #393f45); background: transparent; }

.driver-popover.onboarding .driver-popover-skip-btn:hover, .driver-popover.onboarding .driver-popover-prev-btn:hover { background: var(--transparent-gray-10, rgba(37, 42, 46, .1)); }

.driver-popover.onboarding .driver-popover-close-btn { display: none !important; }

.driver-popover.onboarding .driver-popover-navigation-btns { gap: 3px; }

:not(body):has(> .driver-active-element) { overflow: visible !important; }

.driver-popover.onboarding [data-onboarding-active-index="0"].driver-popover-arrow-align-start.driver-popover-arrow-side-left { top: 50%; }

@media screen and (min-width: 1024px) {
  .driver-popover.onboarding [data-onboarding-active-index="0"].driver-popover-arrow-align-start.driver-popover-arrow-side-left { margin-top: -16px; }
}

@media screen and (min-width: 1424px) {
  .driver-popover.onboarding [data-onboarding-active-index="0"].driver-popover-arrow-align-start.driver-popover-arrow-side-left { margin-top: -6px; }
}

@media screen and (max-width: 1024px) {
  .driver-popover.onboarding [data-onboarding-active-index="3"] { right: inherit; left: 50%; margin-inline-start: -5px; }
}
