.app-phone-input { max-width: 356px; }

.app-phone-input__wrapper { position: relative; height: 48px; text-align: start; gap: 4px; }

.app-phone-input__wrapper .wrapper__country-code { flex-grow: 1; color: rgb(var(--v-theme-black)); }

.app-phone-input__wrapper .input-wrapper { gap: 8px; }

.app-phone-input__wrapper .dropdown-list__wrapper { z-index: 1; }

.app-phone-input__wrapper.above { flex-direction: column-reverse !important; }

.app-phone-input__dropdown { position: relative; display: flex; justify-content: flex-start; align-items: center; width: 108px; padding: 14px 8px 14px 12px; color: var(--v-black-base); background-color: rgb(var(--v-theme-white)); border-radius: 8px; border: 1px solid rgb(var(--v-theme-gray-40)); cursor: pointer; }

.app-phone-input__dropdown:hover { background-color: rgb(var(--v-theme-gray-10)); }

.app-phone-input__dropdown:focus-within { background-color: rgb(var(--v-theme-white)); border-color: transparent; box-shadow: 0 0 0 4px rgb(var(--v-theme-link-40)); }

.app-phone-input__dropdown-list { height: 100%; max-height: 202px; text-align: left; list-style: none; overflow-y: scroll; scrollbar-width: thin; scrollbar-color: rgb(var(--v-theme-gray-50)) rgb(var(--v-theme-white)); padding: 0px !important; }

.app-phone-input__dropdown-list::-webkit-scrollbar { width: 6px; }

.app-phone-input__dropdown-list::-webkit-scrollbar-track { background-color: rgb(var(--v-theme-white)); }

.app-phone-input__dropdown-list::-webkit-scrollbar-thumb { background-color: rgb(var(--v-theme-gray-50)); border-radius: 4px; }

.app-phone-input__dropdown-list.show { max-height: 300px; overflow: scroll; }

.app-phone-input__dropdown-list.open { background-color: rgb(var(--v-theme-white)); }

.app-phone-input__dropdown-list.disabled { background-color: rgb(var(--v-theme-error-40)); cursor: no-drop; outline: none; }

.app-phone-input__input { width: 100%; padding: 12px; background-color: rgb(var(--v-theme-white)); border-radius: 8px; border: 1px solid rgb(var(--v-theme-gray-40)); outline: none; }

.app-phone-input__input:hover { background-color: rgb(var(--v-theme-gray-10)); }

.app-phone-input__input:focus-within { background-color: rgb(var(--v-theme-white)); border-color: transparent; box-shadow: 0 0 0 4px rgb(var(--v-theme-link-40)); }

.app-phone-input__error .app-phone-input__wrapper { border-color: rgb(var(--v-theme-error-70)); }

.app-phone-input__error .app-phone-input__dropdown, .app-phone-input__error .app-phone-input__input { background-color: rgb(var(--v-theme-error-40)); }

.app-phone-input__selection { display: flex; align-items: center; width: 100%; }

.app-phone-input__dropdown-item { display: flex; align-items: center; padding: 6px 20px 6px 14px; gap: 4px; cursor: pointer; }

.app-phone-input__dropdown-item:focus-visible { outline: none !important; }

.app-phone-input__dropdown-item.highlighted { background-color: rgb(var(--v-theme-gray-10)); }

.app-phone-input__dropdown-item.last-preferred { border-bottom: 1px solid rgb(var(--v-theme-gray-80)); }

.app-phone-input__dropdown-item:last-child { margin-bottom: 8px; }

.app-phone-input__dropdown-item .item__code { color: rgb(var(--v-theme-gray-80)); }

.app-phone-input__dropdown-item .item__country-name { max-width: 210px; }

.app-phone-input__dropdown-item .item__flag-wrapper { display: flex; align-items: center; }

.app-phone-input .disabled .app-phone-input__dropdown, .app-phone-input .disabled input { cursor: no-drop; }

.app-phone-input__search_box { width: auto; border-radius: 8px; margin: 12px 16px !important; }

.app-phone-input__search_box:focus-within { border-color: transparent; box-shadow: 0 0 0 4px rgb(var(--v-theme-link-40)); }

.app-phone-input .flag { display: inline-block; margin-inline-end: 8px; transform: scale(1.2); border-radius: 2px; border: 1px solid rgb(var(--v-theme-gray-20)); }

.app-phone-input .app-icon { pointer-events: none; }

.app-phone-input .dropdown-list__wrapper { position: relative; width: 100%; margin: 0px; background-color: rgb(var(--v-theme-white)); border: 1px solid rgb(var(--v-theme-gray-30)); border-radius: 8px; box-shadow: rgba(0, 0, 0, 0.05) 0px 2px 4px, rgba(0, 0, 0, 0.1) 0px 8px 32px 6px; padding: 0px !important; }

.app-badge[data-v-3603cbac] { width: fit-content; border-radius: 6px; }

@media (max-width: 389.98px) {
  .app-badge[data-v-3603cbac] { border-radius: 4px; }
}

.app-simple-card__border-radius[data-v-17252a78] { border-radius: 24px; }

@media (max-width: 1023.98px) {
  .app-simple-card__border-radius[data-v-17252a78] { border-radius: 16px; }
}

@media (max-width: 389.98px) {
  .app-simple-card__border-radius[data-v-17252a78] { border-radius: 12px; }
}

.app-simple-card--shadow[data-v-17252a78] { box-shadow: rgba(120, 143, 165, 0.05) 0px 4px 16px; }

.app-simple-card__border[data-v-17252a78] { top: 0px; left: 0px; width: 100%; height: 100%; border: 1px solid rgb(var(--v-theme-gray-20)); }

.app-simple-card__border--active[data-v-17252a78] { border-color: rgb(var(--v-theme-primary-70)); border-width: 2px; }

@media (max-width: 389.98px) {
  .app-simple-card__border--active[data-v-17252a78] { border-width: 1px; }
}

.app-simple-card__content[data-v-17252a78] { height: 100%; }

.app-bottom-bar[data-v-b33546a7] { left: 0px; bottom: 0px; z-index: 100; width: 100%; border-top: 3px solid rgb(var(--v-theme-gray-20)); }

.slide-up-enter-active[data-v-b33546a7], .slide-up-leave-active[data-v-b33546a7] { transition: transform 0.4s; }

.slide-up-enter-from[data-v-b33546a7], .slide-up-leave-to[data-v-b33546a7] { transform: translateY(100%); }

html { overflow-y: auto !important; }

@media (max-width: 1423.98px) {
  html { font-size: 14px; }
}

@media (min-width: 1424px) {
  html { font-size: 16px; }
}

html ::-webkit-scrollbar { width: 4px; }

html ::-webkit-scrollbar-thumb { background-color: rgb(var(--v-theme-gray-50)); border-radius: 4px; }

html ::-webkit-scrollbar-track { background-color: transparent; border-radius: 4px; }

html * a { text-decoration: none; }

html .container { max-width: 1360px; margin: 0px auto; padding-inline-start: var(--padding-inline-container); padding-inline-end: var(--padding-inline-container); }

@media (min-width: 1024px) {
  html .container { --padding-inline-container: 1.5rem; }
}

@media (max-width: 1023.98px) {
  html .container { --padding-inline-container: 1rem; }
}

@media (max-width: 390.98px) {
  html .container { --padding-inline-container: .5rem; }
}

@media (min-width: 1424px) {
  html .container { --padding-inline-container: 0; }
}

html .v-tooltip > .v-overlay__content { pointer-events: auto !important; }

@media (max-width: 390.98px) {
  html .v-dialog--fullscreen > .v-overlay__content { border-radius: 0px !important; }
}

.line-height-100 { line-height: 100% !important; }

.line-height-120 { line-height: 120% !important; }

.line-height-122 { line-height: 122% !important; }

.line-height-125 { line-height: 125% !important; }

.line-height-140 { line-height: 140% !important; }

.line-height-150 { line-height: 150% !important; }

.width-auto { width: auto !important; }

.width-fit { width: fit-content !important; }

.width-full { width: 100% !important; }

.width-half { width: 50% !important; }

.height-full { height: 100% !important; }

.z-index-5 { z-index: 5 !important; }

.z-index-10 { z-index: 10 !important; }

.z-index-20 { z-index: 20 !important; }

.z-index-30 { z-index: 30 !important; }

.z-index-40 { z-index: 40 !important; }

.z-index-50 { z-index: 50 !important; }

.z-index-100 { z-index: 100 !important; }

.z-index-1000 { z-index: 1000 !important; }

.v-application ul { padding-inline: 0px; }

.v-application li { list-style-type: none; }

.v-application .font-family-roboto { font-family: "Roboto Flex", sans-serif !important; }

.cursor-pointer .v-select__slot { cursor: pointer; }

.divider-compact { margin-top: 6px; margin-bottom: 6px; }

.truncated-text { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; text-overflow: ellipsis; overflow: hidden; }

.app-button--gold { background: var(--primary-gold-gradient-100); box-shadow: rgba(206, 151, 28, 0.2) 0px 4px 4px; border-color: var(--primary-gold-80) !important; }

.app-button--gold:hover { background: var(--primary-gold-gradient-90-alt) !important; border-color: var(--primary-gold-90) !important; }

.app-button--gold:active { background: var(--primary-gold-gradient-80-alt) !important; border-color: var(--primary-gold-90) !important; }

.app-button--gold--disabled { background: rgb(var(--v-theme-gray-10)); }

.blocked .layout-main__content { filter: blur(2px); pointer-events: none; }

:root { --primary-gold-gradient-100: linear-gradient(225deg, var(--primary-gold-100) .52%, var(--secondary-gold-100) 100.52%); --primary-gold-gradient-90: radial-gradient(50% 50% at 50% 50%, var(--primary-gold-90) 0%, var(--secondary-gold-90) 100%); --primary-gold-gradient-90-alt: linear-gradient(225deg, var(--secondary-gold-90-alt) .52%, #856613 100.52%); --primary-gold-gradient-80: linear-gradient(180deg, var(--primary-gold-80) 0%, var(--secondary-gold-80) 100%); --primary-gold-gradient-80-alt: linear-gradient(225deg, #9a6b0e .52%, #876f40 .53%, #7a6326 100.52%); --primary-gold-100: #e1a329; --primary-gold-90: #e9c365; --primary-gold-80: #f5f2d8; --secondary-gold-100: #bb8b10; --secondary-gold-90: #dbac66; --secondary-gold-90-alt: #bb8927; --secondary-gold-80: #f0e5c7; --secondary-gold-60: #5e490d; --secondary-gold-50: #726747; --secondary-gold-40: #e8dcbb; --secondary-gold-30: #f2ead3; --secondary-gold-20: #f9f1d9; --secondary-gold-10: #f8f5ee; --accent-gold: #56351d; --box-shadow: 0 4px 16px 0 rgba(120, 143, 165, .05); }

.app-module-spinner[data-v-1f575fef] { width: auto; }
