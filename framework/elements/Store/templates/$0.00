.help-contacts[data-v-eece95ca] { max-width: 360px; }

.help-contacts__list[data-v-eece95ca] { list-style: none; }
------MultipartBoundary--g3q0EesLRy1HfAbNyts6nqtwJvBFc5TIFQkNXNEU0t----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://site0809.praio.me/assets/modal-template-RLqzAwUB.css

@charset "utf-8";

.modal-template[data-v-ff480c88] { --template-gap: 32px; position: relative; height: 100%; gap: var(--template-gap); }

@media (max-width: 390.98px) {
  .modal-template[data-v-ff480c88] { --template-gap: 0; height: calc(-48px + 100vh); }
}

@media (min-width: 391px) and (max-width: 1023.98px) {
  .modal-template[data-v-ff480c88] { --template-gap: 24px; }
}

.modal-template__header[data-v-ff480c88] { width: calc(100% - 32px); gap: 8px; }

@media (max-width: 390.98px) {
  .modal-template__title-wrapper[data-v-ff480c88] { position: relative; }
  .modal-template__title-wrapper[data-v-ff480c88]::after { content: ""; position: absolute; left: -24px; bottom: 0px; width: calc(100% + 80px); height: 1px; background-color: rgb(var(--v-theme-gray-20)); }
  .modal-template__note[data-v-ff480c88] { width: calc(100% + 32px); }
}

.modal-template__icon[data-v-ff480c88] { width: 80px; height: 80px; }

.modal-template__content[data-v-ff480c88] { height: 100%; background-color: rgb(var(--v-theme-gray-10)); border: 1px solid rgb(var(--v-theme-gray-20)); border-radius: 24px; }

@media (max-width: 390.98px) {
  .modal-template__content[data-v-ff480c88] { width: calc(100% + 48px); margin-left: -24px; border-radius: 0px; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1px solid rgb(var(--v-theme-gray-20)); }
}

@media (min-width: 600px) {
  .modal-template__content[data-v-ff480c88] { padding-right: 40px !important; padding-left: 40px !important; }
}

.modal-template__text[data-v-ff480c88] { max-width: 400px; overflow-wrap: anywhere; }
------MultipartBoundary--g3q0EesLRy1HfAbNyts6nqtwJvBFc5TIFQkNXNEU0t----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://site0809.praio.me/assets/security-BvCi2Nbw.css

@charset "utf-8";

.list-item[data-v-05397fdf] { display: grid; }

@media (max-width: 390.98px) {
  .list-item[data-v-05397fdf] { grid-auto-flow: row; }
}

@media (min-width: 391px) {
  .list-item[data-v-05397fdf] { grid-template-columns: max-content 1fr; }
}

.list-icon[data-v-05397fdf] { width: var(--size); height: var(--size); border: 1px solid; }

@media (max-width: 1023.98px) {
  .list-icon[data-v-05397fdf] { --size: 48px; }
}

@media (min-width: 1024px) {
  .list-icon[data-v-05397fdf] { --size: 56px; }
}

.list-icon.list-icon[data-v-05397fdf] { border-color: rgb(var(--v-theme-gray-20)) !important; }

.list-icon svg[data-v-05397fdf] { width: calc(var(--size) - 24px); height: calc(var(--size) - 24px); }

@media (min-width: 391px) {
  .list-app-divider[data-v-05397fdf] { grid-column: 1 / span 2; }
}

@media (max-width: 1023.98px) {
  .list-content[data-v-05397fdf] { display: grid; }
}

@media (min-width: 1024px) {
  .list-content[data-v-05397fdf] { position: relative; }
}

.security-status[data-v-05397fdf] { cursor: default; }

@media (min-width: 1024px) {
  .security-status[data-v-05397fdf] { position: absolute; top: 0px; right: 0px; }
  .v-locale--is-rtl .security-status[data-v-05397fdf] { left: 0px; right: inherit; }
}
------MultipartBoundary--g3q0EesLRy1HfAbNyts6nqtwJvBFc5TIFQkNXNEU0t----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://site0809.praio.me/assets/tab-balance-setting-D9avvgSq.css

@charset "utf-8";

.w-tab-balance-setting[data-v-4bfc2c29] { box-shadow: var(--box-shadow) !important; border: 1px solid rgb(var(--v-theme-gray-20)) !important; }

.w-tab-balance-setting__container[data-v-4bfc2c29] { min-height: 32px; }

.w-tab-balance-setting .app-switch[data-v-4bfc2c29] .v-input--selection-controls__input, .w-tab-balance-setting .app-switch[data-v-4bfc2c29] .v-input--switch__track { width: 48px; height: 24px; }

.w-tab-balance-setting .app-switch[data-v-4bfc2c29] .v-input--switch__track { top: 0px; background-color: rgb(var(--v-theme-gray-40)); border: 1px solid rgb(var(--v-theme-gray-50)); }

.w-tab-balance-setting .app-switch[data-v-4bfc2c29] .v-input--switch__thumb { top: 4px; width: 16px; height: 16px; transform: translate(2px) !important; }

.w-tab-balance-setting .app-switch[data-v-4bfc2c29] .v-input--switch--inset.v-input--is-dirty .v-input--switch__thumb { transform: translate(26px) !important; }

.w-tab-balance-setting .app-switch[data-v-4bfc2c29] .v-input--is-label-active .v-input--switch__track { border-color: rgb(var(--v-theme-primary-80)); background-color: rgb(var(--v-theme-primary)) !important; }

.w-tab-balance-setting--rtl .app-switch[data-v-4bfc2c29] :not(.v-input--is-dirty) .v-input--switch__thumb { transform: translate(-2px) !important; }

.w-tab-balance-setting--rtl .app-switch[data-v-4bfc2c29] .v-input--switch--inset.v-input--is-dirty .v-input--switch__thumb { transform: translate(-26px) !important; }
------MultipartBoundary--g3q0EesLRy1HfAbNyts6nqtwJvBFc5TIFQkNXNEU0t----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://site0809.praio.me/assets/page-profile-DATT8t94.css

@charset "utf-8";

.card-titled[data-v-e81a3354] { background-color: rgb(var(--v-theme-white)); cursor: default; height: min-content !important; border-color: rgb(var(--v-theme-gray-20)) !important; box-shadow: var(--box-shadow) !important; }

.card-titled .header[data-v-e81a3354] { gap: 4px; }

.user-contacts-item__content-wrapper[data-v-f9132cb5] { overflow: hidden; gap: 16px; }

.user-contacts-item__content[data-v-f9132cb5] { overflow: hidden; }

.user-contacts-item__content .content__button[data-v-f9132cb5] { gap: 8px; }

.user-contacts-item__verify-info[data-v-f9132cb5], .user-contacts-item__verify-info-link[data-v-f9132cb5] { cursor: pointer; }

.user-contacts-item__main-icon[data-v-f9132cb5] { padding: 7px; background-color: rgb(var(--v-theme-gray-10)); border: 1px solid rgb(var(--v-theme-gray-20)); width: 40px !important; height: 40px !important; }

.user-contacts-item .item__text[data-v-f9132cb5] { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.user-contacts[data-v-5726ce54] { gap: 16px; border: 1px solid rgb(var(--v-theme-gray-20)); }

.user-contacts__items[data-v-5726ce54] { gap: 4px; }

.v-application .app-chip { pointer-events: none; }

.v-application .app-chip.app-chip-gold { min-width: 53px; height: 24px; padding: 1px !important; background-color: var(--secondary-gold-20) !important; border: 1px solid var(--primary-gold-100) !important; }

.v-application .app-chip.app-chip-gold .app-chip-gold__text { color: var(--primary-gold-100) !important; }

.v-application .app-chip.app-chip-gold.app-chip-gold--enabled { background-color: rgb(var(--v-theme-white)) !important; }

.v-application .app-chip.app-chip-gold:hover { background-color: inherit; }

.user-info { background: transparent; cursor: default; border-radius: 16px !important; }

@media (max-width: 1023.98px) {
  .user-info { width: 100% !important; }
}

.user-info__name { background: transparent; hyphens: auto; flex-direction: row !important; }

.user-info--gold { background-color: rgb(var(--v-theme-white)); border: 1px solid rgb(var(--v-theme-gray-10)); gap: 12px; }

.user-info--gold .user-info__name { position: relative; z-index: 1; background-image: var(--primary-gold-gradient-80); border: 1px solid var(--secondary-gold-40); border-radius: 16px !important; }

.user-info--gold .user-info__name::before { content: ""; position: absolute; top: 0px; right: 0px; z-index: -1; width: 100%; height: 100%; background-image: url("/assets/accent-F0JWzv3v.svg"); background-position: right center; }

.user-info--gold .user-info__about-gold, .user-info--gold .user-info__gold-left { color: var(--secondary-gold-50) !important; }

.user-info--gold .user-info__tooltip .app-tooltip__activator { display: flex; }

.user-info--rtl .user-info__name::before { transform: scale(-1); }

.page-profile__content[data-v-d3fa92e0] { display: grid; grid-template-columns: minmax(0px, 1fr); }

@media (max-width: 1423.98px) {
  .page-profile__content[data-v-d3fa92e0] { row-gap: 16px; }
}

@media (min-width: 1424px) {
  .page-profile__content[data-v-d3fa92e0] { row-gap: 24px; }
}

.page-profile__user-info[data-v-d3fa92e0] { gap: 24px; }

@media (max-width: 1024px) {
  .page-profile__user-info[data-v-d3fa92e0] { flex-direction: column; gap: 16px; }
}

.page-profile__main[data-v-d3fa92e0] { display: grid; }

@media (max-width: 1423.98px) {
  .page-profile__main[data-v-d3fa92e0] { grid-template-columns: minmax(0px, 1fr); row-gap: 16px; }
}

@media (min-width: 1424px) {
  .page-profile__main[data-v-d3fa92e0] { grid-template-columns: repeat(1, minmax(calc(50% - 12px), 1fr)); column-gap: 24px; }
}
