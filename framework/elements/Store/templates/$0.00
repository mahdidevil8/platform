.slider-button { position: relative; min-width: 40px; height: 172px; background-color: rgb(var(--v-theme-white)); cursor: pointer; border: 1px solid rgb(var(--v-theme-gray-30)); border-radius: 16px; box-shadow: var(--box-shadow); }

@media (min-width: 1424px) {
  .slider-button { height: 200px; }
}

@media (min-width: 1024px) and (max-width: 1423.98px) {
  .slider-button { min-width: 32px; height: 200px; }
